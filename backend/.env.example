# Copy this file to backend/.env and fill in the values.
# Never commit the real .env file.

APP_NAME=Exam Nigahban API
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# Local MySQL (default). For PostgreSQL set DB_DRIVER=postgresql and DB_PORT=5432.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=exam_nigahban

# Alternative to the DB_* values above: one full connection string, e.g.
#DATABASE_URL=postgresql://user:password@host:5432/exam_nigahban

# --- Security ---------------------------------------------------------------
# Required: a random string of at least 32 characters. The API refuses to
# start with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET

# The exact origin(s) the frontend is served from, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional, shown with their defaults.
#JWT_ALGORITHM=HS256
#ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Evidence storage -------------------------------------------------------
# "local" saves evidence images under EVIDENCE_STORAGE_ROOT (fine for local use).
# "s3" uses S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...).
EVIDENCE_BACKEND=local
EVIDENCE_STORAGE_ROOT=evidence
#EVIDENCE_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#EVIDENCE_S3_BUCKET=exam-nigahban-evidence
#EVIDENCE_S3_REGION=auto
#EVIDENCE_S3_ACCESS_KEY_ID=
#EVIDENCE_S3_SECRET_ACCESS_KEY=
